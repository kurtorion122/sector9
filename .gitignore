```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.exe
*.dll
*.so
*.class
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build directories
dist/
build/
target/
*.jar
*.war
*.zip
*.tar.gz

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.log

# OS generated files
.DS_Store
Thumbs.db

# Coverage and testing
.coverage
coverage/
htmlcov/
.mypy_cache/
.pytest_cache/

# Compressed files
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
```