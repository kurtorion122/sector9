```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
yarn.lock
package-lock.json

# Build outputs
dist/
build/
.next/
.nuxt/
out/

# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.ts.map

# Environment
.env
.env.local
.env.*
!.env.example

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/
.nyc_output/
```